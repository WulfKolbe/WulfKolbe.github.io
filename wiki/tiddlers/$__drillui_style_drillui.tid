tags: $:/tags/Stylesheet
title: $:/drillui/style/drillui
type: text/vnd.tiddlywiki

[data-tiddler-title="drillui"] .drillui-frame {
  display:block; width:100%; height:78vh; border:0; background:#1d2021;
}
[data-tiddler-title="drillui"] .drillui-bar {
  display:flex; gap:6px; align-items:center; flex-wrap:wrap; margin-bottom:6px;
}
[data-tiddler-title="drillui"] .drillui-which {
  flex:1 1 auto; font-family:ui-monospace,monospace; font-size:11.5px; opacity:.7;
}
[data-tiddler-title="drillui"] .drillui-tab { white-space:nowrap; text-decoration:none; }
[data-tiddler-title="drillui"] .drillui-warn {
  padding:8px 12px; margin-bottom:6px; border-left:3px solid #fb4934;
  background:rgba(251,73,52,.08); line-height:1.5;
}
[data-tiddler-title="drillui"] .drillui-foot {
  margin-top:6px; font-size:11.5px; opacity:.65; line-height:1.5;
  word-break:break-all;
}
