\function drillui.route.codespace() [<drillui.hostname>search-replace:g:regexp[-\d+\.app\.github\.dev$],[-8787.app.github.dev]addprefix[https://]addsuffix[/]]

\function drillui.route.cocalc.here() [<drillui.pathname>splitregexp[/]butfirst[]first[]addprefix[/]addprefix<drillui.origin>addsuffix[/server/8787]]

\function drillui.auto() [<drillui.hostname>regexp[\.app\.github\.dev$]then<drillui.route.codespace>] ~[<drillui.hostname>regexp[cocalc]then<drillui.route.cocalc.here>] ~[<drillui.hostname>regexp[^(localhost|127\.0\.0\.1)$]then<drillui.route.localhost>] ~[<drillui.route.cocalc>]

\function drillui.which() [<drillui.hostname>regexp[\.app\.github\.dev$]then[codespace (derived from this wiki's host)]] ~[<drillui.hostname>regexp[cocalc]then[cocalc (derived from this wiki's path)]] ~[<drillui.hostname>regexp[^(localhost|127\.0\.0\.1)$]then[localhost]] ~[cocalc (bookmarked — this wiki is elsewhere)]

\function drillui.url() [{$:/temp/drillui/bridge}!match[]] ~[<drillui.auto>]
\function drillui.pinned() [{$:/temp/drillui/bridge}!match[]]
\function drillui.samesite() [<drillui.url>regexp[cocalc]] :filter[<drillui.url>!prefix<drillui.origin>]
\function drillui.mixed() [<drillui.protocol>match[https:]] :filter[<drillui.url>prefix[http://]] :filter[<drillui.url>!prefix[http://localhost]] :filter[<drillui.url>!prefix[http://127.0.0.1]]

