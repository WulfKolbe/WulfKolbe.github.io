#!/usr/bin/env bash
# Start the TiddlyWiki node server. Edits in the browser are written straight
# back into wiki/tiddlers/ as .tid files by the filesystem plugin.
set -e
cd "$(dirname "$0")"
if [ ! -x .bun/bin/bun ] || [ ! -d node_modules/tiddlywiki ]; then ./setup; fi
exec .bun/bin/bun node_modules/tiddlywiki/tiddlywiki.js wiki \
	--listen host=127.0.0.1 port="${PORT:-8080}"
